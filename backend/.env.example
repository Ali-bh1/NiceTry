# Phishing Detection Platform — Environment Variables
# Copy this file to .env and fill in your values

# --- Application ---
APP_NAME=Phishing Detection Platform
APP_VERSION=2.0.0
DEBUG=true
API_PREFIX=/api/v1

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./phishing_platform.db

# --- ML Model ---
DETECTION_THRESHOLD=0.5
HIGH_RISK_THRESHOLD=0.75

# --- Brand Detection ---
BRAND_SIMILARITY_THRESHOLD=0.80

# --- AI Investigator (optional) ---
# Set to "openai" or "gemini" and provide API key for LLM narratives
AI_PROVIDER=template
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
