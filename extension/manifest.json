{
  "manifest_version": 3,
  "name": "PhishGuard — Phishing Protection",
  "version": "1.0.0",
  "description": "Real-time phishing detection powered by a 7-layer AI analysis pipeline. Detect, Explain, Protect.",
  "permissions": [
    "storage",
    "activeTab",
    "webNavigation",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://api.phishguard.local/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "PhishGuard"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
