# ─── Production Settings ───
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ─── CORS (replace with your actual domain) ───
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com","chrome-extension://*"]

# ─── Database ───
DATABASE_URL=sqlite+aiosqlite:///./phishing_platform.db

# ─── Rate Limiting ───
RATE_LIMIT_PER_MINUTE=30

# ─── AI Provider (keep as template unless you have API keys) ───
AI_PROVIDER=template
OPENAI_API_KEY=
GEMINI_API_KEY=
